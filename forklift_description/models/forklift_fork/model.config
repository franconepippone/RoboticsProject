<?xml version="1.0" ?>
<model>
  <name>forklift_fork</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Lifting fork attachment for TurtleBot4: fixed mast rigidly attached
    to the robot, carriage with a vertical prismatic joint, and two tines
    solidary with the carriage. Dynamic attachment to packages is created
    at runtime by the forklift_manager node.
  </description>

  <dependencies>
    <gazebo version_gte="8.0.0"/>
  </dependencies>
</model>